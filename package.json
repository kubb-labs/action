{
  "name": "@kubb-labs/action",
  "version": "0.1.0",
  "private": true,
  "description": "Publish generated Kubb packages from GitHub Actions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubb-labs/action.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "clean": "node -e \"require('node:fs').rmSync('./dist', { recursive: true, force: true })\"",
    "format": "oxfmt -c oxfmt.config.ts .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "start": "tsdown --watch",
    "test": "vitest --passWithNoTests",
    "typecheck": "tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@actions/github": "^8.0.0",
    "@kubb/studio": "^5.2.5",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@kubb/core": "^5.2.5",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.3.1"
}
